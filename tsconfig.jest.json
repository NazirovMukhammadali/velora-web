{
	"compilerOptions": {
		"target": "ES2020",
		"module": "commonjs",
		"moduleResolution": "node",
		"esModuleInterop": true,
		"strict": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"types": ["jest", "node"],
		"resolveJsonModule": true
	},
	"include": ["__tests__/**/*.ts", "libs/utils/**/*.ts", "libs/types/**/*.ts", "libs/auth/**/*.ts", "apollo/store.ts"]
}
